{
  "name": "inkah",
  "version": "1.1.0",
  "private": true,
  "description": "Chinese & Korean pop-up dictionary — browser extension and website",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/conoremclaughlin/inkah"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @inkah/extension run dev",
    "dev:web": "npm -w @inkah/web run dev",
    "build": "npm -w @inkah/extension run build",
    "build:web": "npm -w @inkah/web run build",
    "build:all": "npm run build && npm run build:web",
    "test": "npm -w @inkah/extension run test",
    "test:e2e": "npm -w @inkah/extension run test:e2e",
    "typecheck": "npm -w @inkah/extension run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.2.0"
  }
}
